HEADS AA

START	##	START	**	SU
START	#_	START	*1	RS
START	#S	START	*1	RS
START	|1	START	*D	LS
START	*D	START	*S	DS

START	=1	START	*2	RS
START	=2	START	*2	RS
START	|2	START	_B	LS
START	=B	START	|L	LS
START	=L	START	*L	LS
START	#L	START	*S	DS

