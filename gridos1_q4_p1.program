//	basic / 1 head
//	heads	states	rules	steps
//	1		641		882		14114

HEADS A

START	#	RIGHT1	*	R
RIGHT1	|	DOWN	*	L
DOWN	*	START	*	D

RIGHT1	=	RIGHT2	*	R		// read right
RIGHT2	=	RIGHT2	*	R
RIGHT2	|	BAM		_	L		// hammer nail
BAM		=	LEFT	|	L		// new position for head
LEFT	=	LEFT	*	L		// go back left
LEFT	#	START	*	D

START	_	STOP	*	S