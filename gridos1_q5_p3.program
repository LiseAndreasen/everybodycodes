HEADS	AAA								// outside, middle, inside
START	***		TURN1	***		SDD
TURN1	***		TURN3	***		SSD
TURN3	***		URIGHT	+**		RRR		// up facing movement right

URIGHT	*@*		URIGHT	+**		RRR
URIGHT	*.*		DRIGHT	+++		RRR
DRIGHT	*@*		DRIGHT	**+		RRR
DRIGHT	*.*		URIGHT	+++		RRR

DRIGHT	___		TURN4	***		LLL
TURN4	***		TURN5	***		DLL
TURN5	***		RDOWN	***		DDL

RDOWN	*@*		RDOWN	+**		DDD
RDOWN	*.*		LDOWN	+++		DDD
LDOWN	*@*		LDOWN	**+		DDD
LDOWN	*.*		RDOWN	+++		DDD

LDOWN	___		TURN6	***		UUU
TURN6	***		TURN7	***		LUU
TURN7	***		DLEFT	***		LLU

DLEFT	*@*		DLEFT	+**		LLL
DLEFT	*.*		ULEFT	+++		LLL
ULEFT	*@*		ULEFT	**+		LLL
ULEFT	*.*		DLEFT	+++		LLL

ULEFT	___		TURN8	***		RRR
TURN8	***		TURN9	***		URR
TURN9	***		LUP		***		UUR

LUP		*@*		LUP		+**		UUU
LUP		*.*		RUP		+++		UUU
RUP		*@*		RUP		**+		UUU
RUP		*.*		LUP		+++		UUU

LUP		+++		STOP	***		UUU

