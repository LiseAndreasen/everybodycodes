//	1 head
//	heads	states	rules	steps
//	1		3400	4500	15534

HEADS	A

START	*	UR1		+	R

UR1		!	UR2		+	D		// up facing movement right
UR2		@	UR3		*	U
UR3		*	UR1		*	R
UR2		.	DDR		+	D		// movement down, then right again
DDR		*	DR1		+	R

DR1		!	DR2		+	U
DR2		@	DR3		*	D
DR3		*	DR1		*	R
DR2		.	UUR		+	U
UUR		*	UR1		+	R

DR1		_	RD1		*	L		// turn

RD1		!	RD2		+	L
RD2		@	RD3		*	R
RD3		*	RD1		*	D
RD2		.	LLD		+	L
LLD		*	LD1		+	D

LD1		!	LD2		+	R
LD2		@	LD3		*	L
LD3		*	LD1		*	D
LD2		.	RRD		+	R
RRD		*	RD1		+	D

LD1		_	DL1		*	U

DL1		!	DL2		+	U
DL2		@	DL3		*	D
DL3		*	DL1		*	L
DL2		.	UUL		+	U
UUL		*	UL1		+	L

UL1		!	UL2		+	D
UL2		@	UL3		*	U
UL3		*	UL1		*	L
UL2		.	DDL		+	D
DDL		*	DL1		+	L

UL1		_	LU1		*	R

LU1		!	LU2		+	R
LU2		@	LU3		*	L
LU3		*	LU1		*	U
LU2		.	RRU		+	R
RRU		*	RU1		+	U

RU1		!	RU2		+	L
RU2		@	RU3		*	R
RU3		*	RU1		*	U
RU2		.	LLU		+	L
LLU		*	LU1		+	U

LU2		+	STOP	*	S

