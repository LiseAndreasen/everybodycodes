//=========================================================================

//	10 heads
//	heads	states	rules	steps
//	10		700		2024	2271

(gridos1_q2_p2_10heads.php)

//=========================================================================

//	1 head
//	heads	states	rules	steps
//	1		840		1417	7096

HEADS	A

START	A	READA	_	R
START	B	READB	_	R
START	_	STOP	*	S

READA	A	READA	@	R
READA	B	READB	_	R
READB	A	READA	_	R
READB	B	READB	@	R

READA	_	DOWN	*	D
READB	_	DOWN	*	D

DOWN	*	READX	*	L

READX	A	READAL	_	L
READX	B	READBL	_	L
READX	_	STOP	*	S

READAL	A	READAL	@	L
READAL	B	READBL	_	L
READBL	A	READAL	_	L
READBL	B	READBL	@	L

READAL	_	DOWNR	*	D
READBL	_	DOWNR	*	D

DOWNR	*	START	*	R

//=========================================================================

//	2 states
//	heads	states	rules	steps
//	3		200		1304	6892

HEADS	AAA					// read 2 adjacent places, might write

START	AAA	START	***	SRL	// spread heads, prepare to move right
START	BBB	START	***	SRL
START	!*_	START	**L	SSS

START	AAL	START	@*L	RRS	// read pair, write power symbol
START	BBL	START	@*L	RRS

START	ABL	START	_*L	RRS	// read non-pair, delete
START	BAL	START	_*L	RRS

START	!_L	START	_*R	DDS	// at end of odd line, go down, prepare to move left
START	!_R	START	**R	LLS
START	__R	STOP	**_	SSS

START	AAR	START	*@R	LLS	// read pair, write power symbol
START	BBR	START	*@R	LLS

START	ABR	START	*_R	LLS	// read non-pair, delete
START	BAR	START	*_R	LLS

START	_!R	START	*_L	DDS	// at end of even line, go down, prepare to move right
START	_!L	START	**L	RRS
START	__L	STOP	**_	SSS

//=========================================================================

//	basic
//	heads	states	rules	steps
//	2		400		1204	6792

HEADS AA // read 2 adjacent places, might write

START ** READL ** SR // spread heads, prepare to move right

READL AA READL @* RR // read pair, write power symbol
READL BB READL @* RR

READL AB READL _* RR // read non-pair, delete
READL BA READL _* RR

READL !_ READR _* DD // at end of odd line, go down, prepare to move left
READR !_ READR ** LL
READR __ STOP  ** SS

READR AA READR *@ LL // read pair, write power symbol
READR BB READR *@ LL

READR AB READR *_ LL // read non-pair, delete
READR BA READR *_ LL

READR _! READL *_ DD // at end of even line, go down, prepare to move right
READL _! READL ** RR
READL __ STOP  ** SS
