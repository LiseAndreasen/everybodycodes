//	2 states
//	heads	states	rules	steps
//	6		200		2710	56953

HEADS AAAAAB							// last head to keep track of last line
										// 1st head for state

// 123    5
//  4

START !!!!!! START ****** ULSRDR		// spread heads
START _***** START R***** SSSSSS		// READ state

START R_!_** STOP  _***** SSSSSS		// very short line
START R_!!** START R***** SRRRRS		// beginning of line

START R~==** START R*~*~D SRRRRS		// deeper pond
START R~=#** START R*~*#* SRRRRS		// not deeper pond
START R#==** START R*~*#* SRRRRS
START R#=#** START R*~*#* SRRRRS
START R!#!** START R***#* SRRRRS		// not pond

										// 2: READ2
START R!!_*D START 2****_ SDDDDS		// end of line
										// 4: READ4
START R!!_*_ START 4***** SDDDDS		// next line is last line

START 2_#_** STOP  _*_*** SSSSSS		// very short line
START 2___** STOP  _***** SSSSSS
START 2!__** START 2***** SLLLLS		// beginning of even line
START 2!#_** START 2***** SLLLLS
 
START 2~~~** START 2***~D SLLLLS		// deeper pond
START 2~~#** START 2**_#* SLLLLS		// not deeper pond
START 2#~~** START 2***#* SLLLLS
START 2#~#** START 2**_#* SLLLLS
START 2!##** START 2**_#* SLLLLS		// not pond
START 2!#~** START 2***#* SLLLLS

										// 3: READ3
START 2_##*D START 3*__*_ SDDDDS		// end of even line
START 2_#~*D START 3*_**_ SDDDDS
START 2_~**D START 3****_ SDDDDS
										// 5: READ5
START 2_##*_ START 5*__** SDDDDS		// next line is last line
START 2_#~*_ START 5*_*** SDDDDS
START 2_~**_ START 5***** SDDDDS

START 3_#_** STOP  _*_*** SSSSSS		// very short line
START 3___** STOP  _***** SSSSSS
START 3__!** START 3***** SRRRRS		// beginning of odd line
START 3_#!** START 3***** SRRRRS

START 3~~~** START 3***~D SRRRRS		// deeper pond
START 3~~#** START 3***#* SRRRRS		// not deeper pond
START 3#~~** START 3_**#* SRRRRS
START 3#~#** START 3_**#* SRRRRS
START 3##!** START 3_**#* SRRRRS		// not pond
START 3~#!** START 3***#* SRRRRS

START 3##_*D START 2__**_ SDDDDS		// end of odd line
START 3~#_*D START 2*_**_ SDDDDS
START 3*~_*D START 2****_ SDDDDS
START 3##_*_ START 4__*** SDDDDS		// next line is last line
START 3~#_*_ START 4*_*** SDDDDS
START 3*~_*_ START 4***** SDDDDS

START 4___** STOP  _***** SSSSSS
START 4#__** START 4***** SLLLLS		// last line, even
START 4_#_** STOP  _*_*** SSSSSS
START 4##_** START 4***** SLLLLS
START 4###** START 4**_** SLLLLS
START 4_##** STOP  ____** SSSSSS

START 5___** STOP  _***** SSSSSS
START 5__#** START 5***** SRRRRS		// last line, odd
START 5_#_** STOP  _*_*** SSSSSS
START 5_##** START 5***** SRRRRS
START 5###** START 5_**** SRRRRS
START 5##_** STOP  ___*** SSSSSS

