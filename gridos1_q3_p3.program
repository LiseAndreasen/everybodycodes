//=========================================================================

//	fewer steps - skip a lot of empty space
//	heads	states	rules	steps
//	5		563		1974	24828

HEADS	AAAAB

//	123		5
//	 4

START	*****	READ1	*****	LSRDR

READ1	_#_**	STOP	*****	SSSSS	// very short line

READ1	_!!**	READ1	*****	RRRRS	// beginning of line
READ1	~==**	READ1	*~*~D	RRRRS	// pond gets deeper
READ1	~=#*D	READ2	*~**_	DDDDS	// go down, pond might be deeper
READ1	##!**	READ1	*****	RRRRS	// pond does not get deeper
READ1	~=#*_	READ1	*~***	RRRRS
READ1	#=***	READ1	*~***	RRRRS
READ1	~~~**	READ1	*****	RRRRS
READ1	~~#**	READ1	*****	RRRRS
READ1	~#!**	READ1	*****	RRRRS

READ2	~__**	READ2	*****	LLLLS	// making pond even deeper, left
READ2	~~_**	READ2	*****	LLLLS
READ2	~~~**	READ2	***~D	LLLLS
READ2	_~_**	READ4	****_	UUUUS	// done
READ2	_~~*_	READ4	****_	UUUUS
READ2	_~~*D	READ3	****_	DDDDS	// turn

READ3	__~**	READ3	*****	RRRRS	// making pond even deeper, right
READ3	_~~**	READ3	*****	RRRRS
READ3	~~~**	READ3	***~D	RRRRS
READ3	_~_**	READ4	****_	UUUUS
READ3	~~_*_	READ4	****_	UUUUS
READ3	~~_*D	READ2	****_	DDDDS

READ4	!****	READ4	*****	UUUUS
READ4	_****	READ1	*****	DDDDS

READ1	##_**	STOP	*****	SSSSS
READ1	~#_**	STOP	*****	SSSSS

//=========================================================================

//	1 head
//	heads	states	rules	steps
//	1		1107	1560	94160

HEADS	A

START	#	RIGHT	*	R
RIGHT	#	RIGHT	*	R
RIGHT	=	ONE		~	R		// 1 wave
ONE		=	TWO		~	R		// 2 waves
ONE		#	RIGHT	*	R
TWO		=	THREE	*	L		// 3 waves
TWO		#	RIGHT	*	R

THREE	~	SEVEN	*	D
SEVEN	*	EIGHT	~	L		// 1 new wave below
EIGHT	~	NINE	*	L		// 2 waves
EIGHT	_	FIVE	*	R
NINE	~	TEN		*	R		// 3 waves
NINE	_	SIX		*	R
TEN		*	SEVEN	*	D

THREE	_	FIVE	*	R		// stop making waves
FIVE	~	SIX		*	U
SIX		~	FIVE	*	R
FIVE	=	TWO		~	R

RIGHT	_	STOP	*	S

